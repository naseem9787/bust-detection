# Python / venv
.venv/
__pycache__/
*.pyc

# Downloaded raw cache (regenerate via `python -m src.fetch_data` - see README)
data/raw/*.nc

# Public boundaries file (22.9MB) - refetch with the curl command in
# src/phase2/geography.py's error message rather than committing it
data/raw/india_states.geojson

# Phase 3 ensemble pilot cache (18MB) - regenerate via src/phase3/ensemble_features.py
data/raw/ensemble_pilot_*.parquet

# Phase 4 atmo cache (already covered by data/raw/*.nc above, listed for clarity)
# Phase 4 batch inference outputs - regenerate via src/production/batch_predict.py
outputs/production/batch/

# Phase 5 analog index bulk artifacts (regenerate via build_analog_index.py /
# build_event_index.py) - the small experimental models, scaler, and CSV/MD
# analysis outputs alongside these ARE committed
outputs/phase5/analog_reference_dataset.parquet
models/phase5/reference.parquet
models/phase5/feature_matrix.npy
models/phase5/event_index.parquet

# Phase 2 row-level tables (up to ~40MB each) - regenerate locally via
# run_phase2.py. The trained LightGBM models (.txt, <2MB) and every CSV/
# JSON/MD/PNG analysis output ARE committed - only these bulky per-row
# tables are excluded, matching the Phase 1 error_db/bust_labels policy.
outputs/phase2/features_train.parquet
outputs/phase2/features_test.parquet
outputs/phase2/predictions_*.parquet
outputs/phase2/val_predictions_*.parquet
outputs/phase2/confidence_scores_*.parquet

# Full row-level processed output can exceed GitHub's 100MB/file limit once
# the date range is widened - regenerate locally via `python run_phase0.py`.
# Only the small aggregated summary (data/processed/summary_*.csv) is committed.
data/processed/error_db.parquet
data/processed/bust_labels.parquet

# Run logs / scratch
*.log
_test_*.py

# full-season ensemble spread cache (regenerate: python -m src.verification.ensemble_spread_2021)
data/raw/ens2021/

# static demo snapshot (regenerate: python -m src.production.build_demo_snapshot)
data/demo_snapshot/
data/demo_dist/
data/gh-pages-worktree/
outputs/verification/*.npy
ens2021_fetch.log
bootstrap_ci.log
snapshot_build.log
